# ===== PayNiger — variables d'environnement =====
# Copier ce fichier vers server/.env et adapter.

# Serveur
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL publique de l'API (utilisée pour les liens OAuth / webhooks)
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173

# Base de données (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=payniger
DB_PASSWORD=payniger_dev
DB_NAME=payniger

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Sécurité
JWT_ACCESS_SECRET=changez-moi-access-secret-long-32chars-min
JWT_REFRESH_SECRET=changez-moi-refresh-secret-long-32chars-min
JWT_ACCESS_TTL=900s           # 15 min
JWT_REFRESH_TTL=30d           # 30 jours
BCRYPT_ROUNDS=12

# 2FA par SMS (mock en dev : le code est affiché dans les logs / renvoyé en réponse)
SMS_PROVIDER=mock            # mock | orange | twilio
SMS_API_KEY=
SMS_SENDER=PayNiger

# Agrégateur d'opérateurs (en dev, toutes les cartes sont simulées)
PROVIDER_MODE=mock           # mock | live

# Taux de frais (en millième, ex: 500 = 0.5%)
FEE_RATE_P2P=500
FEE_RATE_CASHOUT=1000
FEE_RATE_BILL=0

# Lien de la tontine / seuils
MAX_TXN_CENTS=5000000        # 5 000 000 FCFA par transaction
